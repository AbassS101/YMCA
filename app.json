{
  "expo": {
    "name": "YMCA Silver Spring",
    "slug": "ymca-silver-spring",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "ymca-silver-spring",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ymcadc.silverspring",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.ymcadc.silverspring",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YMCA Silver Spring to use the camera to scan the barcode on your membership card.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#00609C"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9b80f0f-5639-4ca3-87f6-84fcc70b9812"
      }
    },
    "owner": "awesomefar12"
  }
}
